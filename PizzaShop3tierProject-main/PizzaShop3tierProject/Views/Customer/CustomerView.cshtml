@model PizzaShop.Repository.ViewModels.CustomersPaginationView
@{
    string today = DateTime.Now.Date.ToString("yyyy-MM-dd");
}
<div class="content ms-2 p-2" id="content">
    <div class="Customer-Header">
        <div class="d-flex justify-content-between first-part mb-2">
            <h2>Customers</h2>
            <div class="d-md-flex  align-items-center justify-content-end w-100">
                <div class="input-group w-25 m-2">
                    <input type="text" class="form-control search-or-cus" id="search-customers" placeholder="Search" />
                    <span class="input-group-text"><i class="fa fa-search" aria-hidden="true"></i></span>
                </div>
                <div class="form-controll w-25 m-2">
                    <select name="Time-Search" id="Time-Search" class="form-select Orders-filters"
                        placeholder="Select Time">
                        <option value="All Time">All Time</option>
                        <option value="Today">Today</option>
                        <option value="Last 7 days">Last 7 days</option>
                        <option value="Last 30 days">Last 30 days</option>
                        <option value="Current Month">Current Month</option>
                        <option value="Custom Date" id="custom-date">Custom Date</option>
                    </select>
                </div>
                <div class="modal fade" id="customerDateModal" tabindex="-1" aria-labelledby="exampleModalLabel"
                    aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h1 class="modal-title fs-5" id="exampleModalLabel">Select Date Range</h1>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col">
                                        <div class="row">
                                            <div class="col-md">
                                                <div class="form-floating mb-3">
                                                    <input type="date" name="fromDate" max="@today" id="fromDateC"
                                                        class="form-control" placeholder="Start Date">
                                                    <label for="fromDateC">From Date</label>
                                                </div>
                                            </div>
                                            <div class="col-md mb-3">
                                                <div class="form-floating">
                                                    <input type="date" name="toDate" max="@today" id="toDateC" class="form-control"
                                                        placeholder="End Date">
                                                    <label for="toDate">To Date</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer d-flex justify-content-center">
                                <button type="button" class="btn btn-nonprimary bg-header imp"
                                    id="search-btn-cust-custom">Submit</button>
                                <button type="button" class="btn border-dark me-3 no-imp rounded"
                                    data-bs-dismiss="modal" id="remove-custom-time">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
                <button class="rounded btn-nonprimary d-flex justify-content-center align-items-center" id="Export">
                    <img src="~/images/export-white.svg" width="24px" class="me-2">
                    <p class="m-0">
                        Export
                    </p>
                </button>
            </div>
        </div>
    </div>

    <div class="customers-table rounded shadow" id="customers-table">
        @await Html.PartialAsync("_CustomersTable", Model)
    </div>

</div>
<script>
    $(document).ready(function () {
        $("#search-customers").on("input", function () {
            loadCustomers(1);
        })
        $("#Time-Search").change(function () {
            if($(this).val() != "Custom Date"){
                loadCustomers(1);
            }else{
                $("#fromDateC").val(null);
                $("#toDateC").val(null);
                $("#toDateC").prop("disabled",true);
                $("#toDateC").prop("min",false)
                $("#customerDateModal").modal("show");
            }
        })
        $("#search-btn-cust-custom").click(function(){
            from = $("#fromDateC").val();
            to = $("#toDateC").val();
            if(from == "" || to == ""){
                alert("Please Select From date and To date.");
                return;
            }
            loadCustomers(1,-1,-1,$("#fromDateC").val(),$("#toDateC").val());
            $("#customerDateModal").modal("toggle");
        })
        @* $("#remove-custom-time").click(function(){
            $("#Time-Search").val("All Time");
            $("#customerDateModal").modal("toggle");
        }) *@
        $("#Export").click(function(){
        var searchval = $("#search-customers").val();
        var time = $("#Time-Search").val();
        let url = `/Customer/ForExportExcel?time=${encodeURIComponent(time)}&searchString=${encodeURIComponent(searchval)}`;
        if(time == "Custom Date"){
            from = $("#fromDateC").val();
            to = $("#toDateC").val();
            
            if(from == "" || to == ""){
                alert("Please select from and to date in custom date or change the time filter.");
                return;
            }
            url = url + `&from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`;
        }
        
        window.location.href = url;
        })
        $("#fromDateC").on("input",function(){
            $("#toDateC").prop("disabled",false);
            $("#toDateC").prop("min",$(this).val())
        })
    })
    function loadCustomers(pageno, sortval = -1, sortmethod = -1,from = null , to = null) {
        var searchval = $("#search-customers").val();
        var count = $("#CustomersCount").val();
        var time = $("#Time-Search").val();

        if(time == "Custom Date"){
            from = $("#fromDateC").val();
            to = $("#toDateC").val();
            
            if(from == "" || to == ""){
                alert("Please select from and to date in custom date or change the time filter.");
                return;
            }
        }

        $.ajax({
            url: "/Customer/GetCustomersPaginationView",
            data: {
                count: count,
                searchval: searchval,
                pageno: pageno,
                timefilter: time,
                sortmethod: sortmethod,
                sortval: sortval,
                from : from,
                to : to
            },
            success: (data) => {
                $("#customers-table").html(data);
            }
        })
    }
</script>