@model PizzaShop.Repository.ViewModels.CustomersPaginationView
@{
    var totalpage = (int)Math.Ceiling(((double)Model.totalCustomers / (double)Model.count));
}
<table class="table table-responsive">
    <thead>
        <th data-sorttype = "1">Name <i class="fa fa-long-arrow-up sort-customer for-point" aria-hidden="true" data-sortmeth = "0"></i> <i class="fa fa-long-arrow-down sort-customer for-point" aria-hidden="true" data-sortmeth = "1"></i></th>
        <th>Email </th>
        <th>Phone Number </th>
        <th data-sorttype = "2">Date<i class="fa fa-long-arrow-up sort-customer for-point" aria-hidden="true" data-sortmeth = "0"></i> <i class="fa fa-long-arrow-down sort-customer for-point" aria-hidden="true" data-sortmeth = "1"></i></th>
        <th data-sorttype = "3">Total orders <i class="fa fa-long-arrow-up sort-customer for-point" aria-hidden="true" data-sortmeth = "0"></i> <i class="fa fa-long-arrow-down sort-customer for-point" aria-hidden="true" data-sortmeth = "1"></i></th>
    </thead>
    <tbody>
        @if(Model.customers.Any()){
            @foreach(var customer in Model.customers){
                <tr data-customerid = "@customer.CustomerId">
                    <td>@customer.Firstname</td>
                    <td>@customer.Email</td>
                    <td>@customer.Contactnumber</td>
                    <td>@customer.OrderDate.ToShortDateString()</td>
                    <td>@customer.totalOrders</td>
                </tr>
            }
        }else{
            <tr>
                <td colspan="12" class="text-center">No Records Found.</td>
            </tr>
        }
    </tbody>
</table>
<div class="d-flex justify-content-end  p-2">
    <div class="dropdown d-flex justify-content-center align-items-center w-25">
        <p class="w-50 text-center m-2">Modifiers per page</p>
        <select name="CustomersCount" id="CustomersCount" asp-for="@Model.count" class="form-control w-25">
            <option value="5" selected>5</option>
            <option value="10">10</option>
            <option value="15">15</option>
        </select>
    </div>
    <div class="d-flex align-items-center">
        <p class="m-2">Showing 1..5 of 14</p>
        <div class="paging d-flex justify-content-around align-items-center">
            <button class="btn border" id="prevCustomers"><i class="fa fa-angle-left" aria-hidden="true"></i></button>
            <button class="btn border" id="nextCustomers"><i class="fa fa-angle-right" aria-hidden="true"></i></button>
        </div>
    </div>
</div>
<script>
    $(document).ready(function(){
        if(@Model.pageno == 1){
            $("#prevCustomers").prop("disabled",true);
        }
        if(@Model.pageno >= @totalpage){
            $("#nextCustomers").prop("disabled",true);
        }

        $("#nextCustomers").click(function(){
            loadCustomers(@Model.pageno + 1);
        })

        $("#prevCustomers").click(function(){
            loadCustomers(@Model.pageno - 1);
        })

        $("#CustomersCount").change(function(){
            loadCustomers(1);
        })
        $(".sort-customer").click(function(){
            loadCustomers(1,$(this).closest("th").data("sorttype"),$(this).data("sortmeth"));
        })
    })
</script>